-- ================= AIMBOT (OPTIMIZADO + DEATH CHECK) =================
local AimRaycastParams = RaycastParams.new()
AimRaycastParams.FilterType = Enum.RaycastFilterType.Blacklist

local function updateRaycastFilter()
	AimRaycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
end

updateRaycastFilter()
LocalPlayer.CharacterAdded:Connect(function()
	task.defer(updateRaycastFilter)
end)

local function getAimPart(char)
	if not char then return nil end

	if AimPartMode == "Head" then
		return char:FindFirstChild("Head")
	end

	return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
end

local function getAliveHumanoid(char)
	if not char then return nil end

	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end

	return nil
end

local function visible(part)
	if not part then return false end

	local origin = Camera.CFrame.Position
	local direction = part.Position - origin
	local ray = workspace:Raycast(origin, direction, AimRaycastParams)

	return not ray or ray.Instance:IsDescendantOf(part.Parent)
end

local function isPlayerExcluded(player)
	for _, excluded in ipairs(ExcludedPlayers) do
		if excluded == player then
			return true
		end
	end
	return false
end

-- Se actualiza varias veces por segundo en vez de recalcular todos los objetivos
-- en cada RenderStepped. El apuntado sigue aplicándose cada frame.
local CachedTarget = nil
local TargetScanInterval = 1 / 30
local TargetScanAccumulator = 0

local function getTarget()
	local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local best, bestDistance = nil, FOV
	local cameraPosition = Camera.CFrame.Position
	local aimDistanceSquared = AIM_DISTANCE * AIM_DISTANCE

	for _, p in ipairs(PlayerCache) do
		if p ~= LocalPlayer and not isPlayerExcluded(p) then
			local char = p.Character

			-- Death Check: ignora personajes muertos o sin Humanoid.
			local humanoid = getAliveHumanoid(char)
			if humanoid then
				local part = getAimPart(char)

				if part then
					local offset = part.Position - cameraPosition

					-- Comparación cuadrática: evita hacer Magnitude/sqrt innecesariamente.
					if offset:Dot(offset) <= aimDistanceSquared and visible(part) then
						local pos, onScreen = Camera:WorldToViewportPoint(part.Position)

						if onScreen then
							local dx = pos.X - center.X
							local dy = pos.Y - center.Y
							local distance = math.sqrt(dx * dx + dy * dy)

							if distance < bestDistance then
								best = part
								bestDistance = distance
							end
						end
					end
				end
			end
		end
	end

	return best
end

RunService.RenderStepped:Connect(function(dt)
	local vs = Camera.ViewportSize

	if FOVCircle.Visible then
		FOVCircle.Position = UDim2.new(0, vs.X / 2, 0, vs.Y / 2)
		FOVCircle.Size = UDim2.new(0, FOV * 2, 0, FOV * 2)
	end

	if AimbotEnabled then
		TargetScanAccumulator += dt

		if TargetScanAccumulator >= TargetScanInterval then
			TargetScanAccumulator = 0
			CachedTarget = getTarget()
		end

		-- Death Check también al momento de usar el objetivo cacheado.
		local target = CachedTarget
		if target and target.Parent then
			local humanoid = target.Parent:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health > 0 then
				Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
			else
				CachedTarget = nil
			end
		else
			CachedTarget = nil
		end
	else
		CachedTarget = nil
		TargetScanAccumulator = 0
	end
end)

