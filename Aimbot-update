local function updateExcludedPlayersDisplay()
	-- Limpiar lista anterior en el scroll frame
	for _, child in pairs(PlayersScrollFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	
	-- Limpiar etiquetas de estado anteriores
	for _, child in pairs(TeamCheckHub:GetChildren()) do
		if child.Name == "StatusLabel" or child.Name == "ClearAllBtn" then
			child:Destroy()
		end
	end
	
	-- Mostrar contador
	local statusLabel = Instance.new("TextLabel", TeamCheckHub)
	statusLabel.Name = "StatusLabel"
	statusLabel.Size = UDim2.new(1,0,0,30)
	statusLabel.Position = UDim2.new(0,0,0,40)
	statusLabel.BackgroundTransparency = 1
	statusLabel.Text = "Jugadores excluidos: " .. #ExcludedPlayers .. "/" .. MaxExcludedPlayers
	statusLabel.Font = Enum.Font.GothamBold
	statusLabel.TextColor3 = Color3.fromRGB(220,180,220)
	statusLabel.TextSize = 18
	statusLabel.TextXAlignment = Enum.TextXAlignment.Center
	
	-- Primero mostrar jugadores excluidos
	local excludedCount = 0
	if #ExcludedPlayers > 0 then
		local excludedLabel = Instance.new("TextLabel", PlayersScrollFrame)
		excludedLabel.Size = UDim2.new(1, 0, 0, 20)
		excludedLabel.BackgroundTransparency = 1
		excludedLabel.Text = "=== EXCLUIDOS ==="
		excludedLabel.Font = Enum.Font.GothamBold
		excludedLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
		excludedLabel.TextSize = 14
		excludedLabel.LayoutOrder = 0
		
		for i, player in ipairs(ExcludedPlayers) do
			local entry = Instance.new("Frame", PlayersScrollFrame)
			entry.Size = UDim2.new(1, 0, 0, 30)
			entry.BackgroundColor3 = Color3.fromRGB(60, 30, 50)
			entry.LayoutOrder = i
			Instance.new("UICorner", entry)
			
			local playerName = Instance.new("TextLabel", entry)
			playerName.Size = UDim2.new(0.7, 0, 1, 0)
			playerName.BackgroundTransparency = 1
			playerName.Text = player.Name
			playerName.Font = Enum.Font.Gotham
			playerName.TextColor3 = Color3.new(1, 1, 1)
			playerName.TextSize = 14
			playerName.TextXAlignment = Enum.TextXAlignment.Left
			playerName.Position = UDim2.new(0, 10, 0, 0)
			
			local removeBtn = Instance.new("TextButton", entry)
			removeBtn.Size = UDim2.new(0, 70, 0, 24)
			removeBtn.Position = UDim2.new(1, -75, 0, 3)
			removeBtn.Text = "REMOVER"
			removeBtn.Font = Enum.Font.GothamBold
			removeBtn.TextSize = 12
			removeBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
			removeBtn.TextColor3 = Color3.new(1, 1, 1)
			Instance.new("UICorner", removeBtn)
			
			removeBtn.MouseButton1Click:Connect(function()
				table.remove(ExcludedPlayers, i)
				updateExcludedPlayersDisplay()
			end)
			
			excludedCount = excludedCount + 1
		end
	end
	
	-- Mostrar todos los jugadores disponibles
	local allPlayers = Players:GetPlayers()
	local availableLabel = Instance.new("TextLabel", PlayersScrollFrame)
	availableLabel.Size = UDim2.new(1, 0, 0, 20)
	availableLabel.BackgroundTransparency = 1
	availableLabel.Text = "=== DISPONIBLES ==="
	availableLabel.Font = Enum.Font.GothamBold
	availableLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
	availableLabel.TextSize = 14
	availableLabel.LayoutOrder = 100 + excludedCount
	
	local layoutOrderCounter = 100 + excludedCount + 1
	
	for _, player in ipairs(allPlayers) do
		if player ~= LocalPlayer then
			local isExcluded = false
			for _, excluded in ipairs(ExcludedPlayers) do
				if excluded == player then
					isExcluded = true
					break
				end
			end
			
			if not isExcluded then
				local entry = Instance.new("Frame", PlayersScrollFrame)
				entry.Size = UDim2.new(1, 0, 0, 30)
				entry.BackgroundColor3 = Color3.fromRGB(34, 44, 40)
				entry.LayoutOrder = layoutOrderCounter
				Instance.new("UICorner", entry)
				
				local playerName = Instance.new("TextLabel", entry)
				playerName.Size = UDim2.new(0.7, 0, 1, 0)
				playerName.BackgroundTransparency = 1
				playerName.Text = player.Name
				playerName.Font = Enum.Font.Gotham
				playerName.TextColor3 = Color3.new(1, 1, 1)
				playerName.TextSize = 14
				playerName.TextXAlignment = Enum.TextXAlignment.Left
				playerName.Position = UDim2.new(0, 10, 0, 0)
				
				local addBtn = Instance.new("TextButton", entry)
				addBtn.Size = UDim2.new(0, 70, 0, 24)
				addBtn.Position = UDim2.new(1, -75, 0, 3)
				addBtn.Text = #ExcludedPlayers < MaxExcludedPlayers and "EXCLUIR" or "LLENO"
				addBtn.Font = Enum.Font.GothamBold
				addBtn.TextSize = 12
				addBtn.BackgroundColor3 = #ExcludedPlayers < MaxExcludedPlayers and Color3.fromRGB(60, 160, 60) or Color3.fromRGB(100, 100, 100)
				addBtn.TextColor3 = Color3.new(1, 1, 1)
				addBtn.AutoButtonColor = #ExcludedPlayers < MaxExcludedPlayers
				Instance.new("UICorner", addBtn)
				
				if #ExcludedPlayers < MaxExcludedPlayers then
					addBtn.MouseButton1Click:Connect(function()
						table.insert(ExcludedPlayers, player)
						updateExcludedPlayersDisplay()
					end)
				end
				
				layoutOrderCounter = layoutOrderCounter + 1
			end
		end
	end
	
	-- Botón para limpiar todos (fuera del scroll)
	if #ExcludedPlayers > 0 then
		local clearBtn = Instance.new("TextButton", TeamCheckHub)
		clearBtn.Name = "ClearAllBtn"
		clearBtn.Size = UDim2.new(0.8, 0, 0, 35)
		clearBtn.Position = UDim2.new(0.1, 0, 1, -40)
		clearBtn.Text = "LIMPIAR TODOS"
		clearBtn.Font = Enum.Font.GothamBold
		clearBtn.TextScaled = true
		clearBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
		clearBtn.TextColor3 = Color3.new(1, 1, 1)
		Instance.new("UICorner", clearBtn)
		
		clearBtn.MouseButton1Click:Connect(function()
			ExcludedPlayers = {}
			updateExcludedPlayersDisplay()
		end)
	end
	
	-- Asegurar que el canvas se actualice
	PlayersScrollFrame.CanvasSize = UDim2.new(0, 0, 0, PlayersListLayout.AbsoluteContentSize.Y)
end

