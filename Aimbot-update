local function createSlider(yPos, text, min, max, value, color, callback)
	local label = Instance.new("TextLabel", Hub)
	label.Position = UDim2.new(0,20,0,yPos)
	label.Size = UDim2.new(0,300,0,18)
	label.BackgroundTransparency = 1
	label.Text = text..": "..value
	label.TextColor3 = Color3.fromRGB(220,220,220)

	local frame = Instance.new("Frame", Hub)
	frame.Position = UDim2.new(0,20,0,yPos+18)
	frame.Size = UDim2.new(0,300,0,26)
	frame.BackgroundColor3 = Color3.fromRGB(34,34,40)
	Instance.new("UICorner", frame)

	local bar = Instance.new("Frame", frame)
	bar.BackgroundColor3 = color
	bar.Size = UDim2.new((value-min)/(max-min),0,1,0)
	Instance.new("UICorner", bar)

	local dragging = false
	frame.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
	end)
	frame.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging then
			local rel = math.clamp((i.Position.X-frame.AbsolutePosition.X)/frame.AbsoluteSize.X,0,1)
			bar.Size = UDim2.new(rel,0,1,0)
			local v = math.floor(min+rel*(max-min))
			label.Text = text..": "..v
			callback(v)
		end
	end)
end

